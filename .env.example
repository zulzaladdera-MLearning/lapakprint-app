# ========================================================
# LapakPrint Ecosystem Environment Variables Configuration
# ========================================================

# --- 1. SUPABASE DATABASE & AUTH (< 1GB Meta PostgreSQL) ---
# Dapatkan dari Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- 2. CLOUDINARY HYBRID STORAGE (5GB Free Tier CDN) ---
# Dapatkan dari Cloudinary Dashboard > Dashboard > Product Environment Credentials
VITE_CLOUDINARY_CLOUD_NAME=lapakprint-cdn
VITE_CLOUDINARY_UPLOAD_PRESET=lapakprint_docs

# --- 3. 9ROUTER DOCKER AI GATEWAY (Primary Google Gemini) ---
# Menghubungkan ke container local nine-router:20129
VITE_9ROUTER_ENDPOINT=http://127.0.0.1:20129/v1/chat/completions
VITE_9ROUTER_API_KEY=sk-0480ac72892daa9b-2s3nyc-5474ac73

# --- 4. XKIRO MULTI-MODEL AI GATEWAY (Cloud Failover 1) ---
# Dapatkan dari https://api.xkiro.com/v1 (mendukung 103+ model)
VITE_XKIRO_ENDPOINT=https://api.xkiro.com/v1/chat/completions
VITE_XKIRO_API_KEY=your-xkiro-api-key
VITE_XKIRO_MODEL=deepseek-ai/DeepSeek-V3

# --- 5. OPENROUTER AGGREGATOR (Cloud Failover 2) ---
VITE_OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# --- 6. SILICONFLOW CLOUD ENGINE (Cloud Failover 3) ---
VITE_SILICONFLOW_API_KEY=sk-siliconflow-your-key

# --- 7. RUNWARE FAST FLUX 300 DPI IMAGE DIFFUSION ---
VITE_RUNWARE_API_KEY=your-runware-api-key
